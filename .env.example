# PostgreSQL
POSTGRES_USER=sss_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=sss_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Salt dùng để băm (ẩn danh) định danh người dùng - ĐỔI thành chuỗi ngẫu nhiên dài và giữ bí mật
ANONYMIZATION_SALT=change_this_to_a_long_random_secret

# API
API_HOST=0.0.0.0
API_PORT=8000
# Origin frontend được phép gọi API (phân tách bởi dấu phẩy nếu nhiều origin)
CORS_ORIGINS=http://localhost:5500

# Collector YouTube (Giai đoạn 2) - lấy API key tại https://console.cloud.google.com/apis/credentials
# (bật "YouTube Data API v3" cho project trước khi tạo key)
# Video theo dõi & từ khóa search cấu hình qua UI (tab "Cấu hình thu thập" trên frontend),
# lưu trong DB (bảng tracked_videos/search_queries) - không còn nằm ở .env.
YOUTUBE_API_KEY=
COLLECTOR_POLL_INTERVAL_MINUTES=60

# Collector TikTok (Giai đoạn 2) - cần đăng ký & được duyệt Research API trước:
# https://developers.tiktok.com/products/research-api
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
